# ==============================================================================
# Nex — Copiloto de Operações de Delivery (Ambiente Demonstrativo)
# ==============================================================================

# API Backend (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./nex.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Chave secreta compartilhada para rotas internas (API <-> n8n)
# OBRIGATÓRIO: Gerar um segredo de alta entropia. Não utilizar valores padrão.
INTERNAL_API_KEY=

# Endpoints de Webhooks do n8n (chamados pela API)
N8N_WEBHOOK_TRIAGE_URL=http://localhost:5678/webhook/nex-wf01-triage
N8N_WEBHOOK_ACTION_URL=http://localhost:5678/webhook/nex-wf02-action
REQUIRE_N8N=true

# Chave da API Google Gemini 
GEMINI_API_KEY=

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
